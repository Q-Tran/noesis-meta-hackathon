# --- Neo4j graph store ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- Service infrastructure ---
KAFKA_BROKERS=localhost:9092
MILVUS_URI=http://localhost:19530

# --- LLM provider: null | openai | ollama ---
# "null" works fully offline (no descriptions/extraction, heuristic fallbacks).
LLM_PROVIDER=null

# Local-only retrieval models. Download scripts support --source and --endpoint
# for Hugging Face-compatible corporate artifact mirrors.
EMBEDDING_MODEL_PATH=models/all-MiniLM-L6-v2
RERANKER_MODEL_PATH=models/ms-marco-MiniLM-L-6-v2
# SSL_CERT_FILE=/path/to/corporate-ca-bundle.pem
# REQUESTS_CA_BUNDLE=/path/to/corporate-ca-bundle.pem

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Power BI / Microsoft Fabric (optional) ---
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
# Required when the app registration is configured as a confidential web app.
FABRIC_CLIENT_SECRET=
FABRIC_TOKEN_CACHE=.fabric-token-cache.json

# --- Microsoft Graph evidence ingestion (optional) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# Optional overrides; defaults are resolved from Microsoft Graph /me.
GRAPH_USER_ID=
GRAPH_USER_EMAIL=
GRAPH_POLL_INTERVAL_SECONDS=300

# --- Snowflake (optional; read-only SQL execution knowledge base) ---
# External-browser SSO auth -- your browser opens for login on first query.
SNOWFLAKE_ACCOUNT=attbusinessdatacoe.east-us-2.privatelink
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=PROD_READER_MED_WH
SNOWFLAKE_DATABASE=PROD_BDI
SNOWFLAKE_SCHEMA=BDIUSER
SNOWFLAKE_ROLE=PROD_BDI_READER

# Corporate proxy settings are optional and honored by HTTP clients.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,neo4j,kafka,milvus
